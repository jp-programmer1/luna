# Copiar a luna-api/.env
NODE_ENV=development
PORT=3000

# El mismo connection string que usás en MongoDB Compass, con /luna como base
MONGO_URI=mongodb://127.0.0.1:27017/luna

# Panel (único origen con CORS + cookie) y portafolio público
PANEL_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:4321

# Firma de los tokens de vista previa. Generalo con: openssl rand -base64 48
PREVIEW_SECRET=

# Sesión: en producción COOKIE_DOMAIN=.lunakuyen.art; en local dejalo vacío
COOKIE_DOMAIN=
SESSION_DAYS=30

# Mail del link mágico. Sin key, en local el link se imprime en la consola.
RESEND_API_KEY=
MAIL_FROM=Panel de Luna <onboarding@resend.dev>

# Mismo valor que isr.bypassToken del portafolio en Vercel. Vacío = no revalida.
REVALIDATE_TOKEN=

# Base pública de los archivos de R2 (fase 2)
MEDIA_BASE_URL=

# Solo si usás docker-compose (producción en el VPS)
# MONGO_ROOT_USER=luna
# MONGO_ROOT_PASSWORD=cambiame
