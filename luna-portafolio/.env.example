# Copiar a luna-portafolio/.env (y cargar las mismas variables en Vercel)

# API del panel. En local: http://localhost:3000 ; en producción: https://api.lunakuyen.art
LUNA_API_URL=http://localhost:3000

# bypassToken del ISR de Vercel. Mismo valor que REVALIDATE_TOKEN en luna-api/.env.
# Vacío = sin ISR (cada visita arma la página).
REVALIDATE_TOKEN=

# Galería desde Google Drive (fase 1; en la fase 2 pasa a la API)
GOOGLE_SA_EMAIL=
GOOGLE_SA_KEY=
PUBLIC_HOME_FOLDER_ID=

# Formulario de contacto (fase 1; en la fase 2 pasa a la API)
GOOGLE_EMAIL=
RESEND_API_KEY=
