---
import SitePage from '../components/SitePage.astro';
import { getPublishedSite } from '../lib/site';

// Con ISR en Vercel esta página se cachea y se regenera cuando Luna publica
// (la API le pega con x-prerender-revalidate). Sin ISR (local) se arma en cada request.
const site = await getPublishedSite();
---

<SitePage site={site} />
