---
import type { RichText } from '@luna/shared';
import { renderRichText } from '../lib/rich-text';
import { variantClass } from '../lib/site';

interface Props {
  anchor: string;
  variant: 'plain' | 'card';
  title: string;
  body: RichText;
  imageUrl: string;
  imagePosition?: string;
  imageAlt: string;
  imageSide: 'left' | 'right';
}
const { anchor, variant, title, body, imageUrl, imagePosition, imageAlt, imageSide } = Astro.props;
const right = imageSide === 'right';
---

<section id={anchor} class:list={['relative z-20 py-32 px-6', variantClass(variant)]} data-bio>
  <div class="container mx-auto max-w-5xl">
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div
        class:list={[
          'relative transition-all duration-1000 opacity-0',
          right ? 'md:order-last translate-x-10' : '-translate-x-10',
        ]}
        data-bio-reveal
      >
        <div class="aspect-[3/4] bg-card overflow-hidden">
          <img
            src={imageUrl}
            alt={imageAlt}
            loading="lazy"
            class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700"
            style={imagePosition ? `object-position: ${imagePosition}` : undefined}
          />
        </div>
        <div class:list={['absolute -bottom-4 w-32 h-32 border-2 border-primary -z-10', right ? '-left-4' : '-right-4']}></div>
      </div>

      <div
        class:list={[
          'transition-all duration-1000 delay-300 opacity-0',
          right ? '-translate-x-10' : 'translate-x-10',
        ]}
        data-bio-reveal
      >
        <h2 class="text-3xl md:text-4xl font-bold mb-6 text-foreground">{title}</h2>
        <div class="space-y-4 text-muted-foreground leading-relaxed" set:html={renderRichText(body)} />
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-bio]').forEach((root) => {
    const parts = root.querySelectorAll<HTMLElement>('[data-bio-reveal]');
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        parts.forEach((el) => {
          el.classList.remove('opacity-0', '-translate-x-10', 'translate-x-10');
          el.classList.add('opacity-100', 'translate-x-0');
        });
        observer.disconnect();
      },
      { threshold: 0.2 },
    );
    observer.observe(root);
  });
</script>
