---
interface Props {
  anchor: string;
  variant: 'plain' | 'card';
  eyebrow: string;
  title: string;
  highlight: string;
  subtitle: string;
  buttons: { label: string; href: string }[];
  backgroundUrl: string | null;
  backgroundPosition?: string;
  nextHref: string | null;
}
const { anchor, eyebrow, title, highlight, subtitle, buttons, backgroundUrl, backgroundPosition, nextHref } = Astro.props;
const [primary, secondary] = buttons;
---

<section id={anchor} class="relative min-h-screen flex items-center justify-center z-20 overflow-hidden">
  {backgroundUrl && (
    <img
      src={backgroundUrl}
      alt=""
      aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover opacity-25"
      style={backgroundPosition ? `object-position: ${backgroundPosition}` : undefined}
    />
  )}
  <div class="relative text-center px-6" data-hero-content>
    {eyebrow && (
      <p class="text-primary text-sm md:text-base uppercase tracking-[0.3em] mb-4 animate-fade-in">{eyebrow}</p>
    )}
    <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold mb-6 tracking-tight text-foreground">
      {title}
      {highlight && <span class="block text-primary">{highlight}</span>}
    </h1>
    {subtitle && (
      <p class="text-muted-foreground text-lg md:text-xl max-w-md mx-auto mb-8 leading-relaxed">{subtitle}</p>
    )}
    {buttons.length > 0 && (
      <div class="flex flex-wrap items-center justify-center gap-6">
        {primary && (
          <a
            href={primary.href}
            class="px-8 py-3 bg-primary text-primary-foreground text-sm uppercase tracking-widest hover:bg-accent transition-colors duration-300"
          >
            {primary.label}
          </a>
        )}
        {secondary && (
          <a
            href={secondary.href}
            class="px-8 py-3 border border-foreground/30 text-foreground text-sm uppercase tracking-widest hover:border-primary hover:text-primary transition-colors duration-300"
          >
            {secondary.label}
          </a>
        )}
      </div>
    )}
  </div>

  {nextHref && (
    <a
      href={nextHref}
      class="absolute bottom-10 left-1/2 -translate-x-1/2 text-muted-foreground animate-bounce"
      aria-label="Desplázate hacia abajo"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </a>
  )}
</section>

<script>
  // Cada portada se desvanece según cuánto se scrolleó pasando SU sección
  // (no la página entera): así una segunda portada más abajo también se ve.
  const els = Array.from(document.querySelectorAll<HTMLElement>('[data-hero-content]'));
  const onScroll = () => {
    for (const el of els) {
      const section = el.closest('section');
      const y = Math.max(0, -(section?.getBoundingClientRect().top ?? 0));
      el.style.transform = `translateY(${y * 0.3}px)`;
      el.style.opacity = String(Math.max(0, 1 - y / 500));
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>
