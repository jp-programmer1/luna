---
import '../styles/global.css';
import { mediaUrl, type PublicSite } from '../lib/site';
import Footer from './Footer.astro';
import Navigation from './Navigation.astro';
import ParallaxMountains from './ParallaxMountains.astro';
import SectionRenderer from './SectionRenderer.astro';
import SpiralDecorations from './SpiralDecorations.astro';

interface Props {
  site: PublicSite;
  preview?: boolean;
}
const { site, preview = false } = Astro.props;
const { settings, sections } = site;

const navItems = sections.filter((s) => s.showInNav).map((s) => ({ label: s.navLabel, href: `#${s.anchor}` }));
const homeHref = sections[0] ? `#${sections[0].anchor}` : '#';
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const ogImage = new URL(mediaUrl(site, settings.seo.ogImageId, '/bio.jpg'), Astro.site ?? Astro.url).toString();
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <link type="image/svg+xml" href="/favicon.svg" rel="icon" />

    <title>{settings.seo.title}</title>
    <meta name="description" content={settings.seo.description} />
    <meta name="author" content={settings.name} />
    {preview ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:title" content={settings.seo.title} />
    <meta property="og:description" content={settings.seo.description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={settings.name} />
  </head>
  <body>
    <main class="relative min-h-screen overflow-x-hidden">
      <ParallaxMountains />
      <SpiralDecorations />
      <Navigation brand={settings.name} homeHref={homeHref} items={navItems} />
      {sections.map((section, i) => <SectionRenderer site={site} section={section} next={sections[i + 1]} />)}
      <Footer text={settings.footerText} />
    </main>
    {import.meta.env.DEV && site.fallbackReason && (
      <div role="alert" class="fixed top-20 left-1/2 -translate-x-1/2 z-50 max-w-xl px-4 py-3 rounded-lg bg-red-100 text-red-900 text-sm shadow-lg" style="font-family: Inter, sans-serif">
        <strong>Solo en desarrollo:</strong> estás viendo el contenido de respaldo, no lo publicado. {site.fallbackReason}
      </div>
    )}
    {preview && (
      <div class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 px-4 py-2 rounded-full bg-primary text-primary-foreground text-xs font-semibold tracking-wide shadow-lg">
        Vista previa · todavía no está publicado
      </div>
    )}
  </body>
</html>
